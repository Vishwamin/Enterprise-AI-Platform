# Copy this file to .env and adjust as needed. .env is gitignored —
# never commit real secrets.

# "development" or "production" — changes logging verbosity and
# whether debug-only endpoints (e.g. /debug/trigger-error) exist.
APP_ENV=development

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Local PostgreSQL connection (Phase 3). Format:
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
# "postgres" / "postgres" below is a common local default — change it
# to match whatever you set when you installed Postgres locally.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_ai_platform
