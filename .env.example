# Copy this file to .env and adjust as needed. .env is gitignored —
# never commit real secrets. Nothing here is secret yet (Phase 2 has
# no database or API keys), but this establishes the pattern before
# Phase 3+ actually need it.

# "development" or "production" — changes logging verbosity and
# whether debug-only endpoints (e.g. /debug/trigger-error) exist.
APP_ENV=development

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
