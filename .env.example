# Copy this file to .env and adjust as needed. .env is gitignored —
# never commit real secrets.

# "development" or "production" — changes logging verbosity and
# whether debug-only endpoints (e.g. /debug/trigger-error) exist.
APP_ENV=development

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Local PostgreSQL connection (Phase 3). Format:
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_ai_platform

# Signs JWTs (Phase 4). THIS ONE IS ACTUALLY SECRET — generate your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never use the value below outside local learning/dev.
SECRET_KEY=dev-only-insecure-secret-change-me

# Minutes before an access token expires and the client must log in again.
ACCESS_TOKEN_EXPIRE_MINUTES=30
